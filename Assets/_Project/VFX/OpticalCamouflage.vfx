  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661615901}
  m_BlockName: Slice animated silhouette
  m_HLSLCode: "void SliceBody(inout VFXAttributes a)\n{\n    uint row = a.particleId % 32u;\n    a.texIndex = (float)row;\n    a.position = float3(0, 0.5 - (row + 0.5) / 32.0, 0);\n    a.size = 1.0;\n    a.scaleY = 1.0 / 32.0;\n}"
  m_ShaderFile: {fileID: 0}

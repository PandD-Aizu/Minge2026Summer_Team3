  m_InputSlots: []
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661615905}
  m_BlockName: Traveling camouflage wave
  m_HLSLCode: "void RefractSilhouette(inout VFXAttributes a)\n{\n    float row = a.position.y;\n    float wave = pow(saturate(cos(row * 12.0 - a.age * 5.0)), 12.0);\n    a.position += float3(0.018 * wave * sin(row * 87.0 + a.age * 9.0), 0, 0);\n    a.color = lerp(float3(0.55, 0.84, 0.94), float3(1.3, 2.1, 2.4), wave);\n    a.alpha = lerp(0.16 + 0.44 * wave, 1.0, saturate(1.0 - a.age * 2.5));\n}"
  m_ShaderFile: {fileID: 0}

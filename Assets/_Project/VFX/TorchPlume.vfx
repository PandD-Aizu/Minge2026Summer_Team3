  m_ActivationSlot: {fileID: 8926484042661615903}
  m_BlockName: Buoyant plume advection
  m_HLSLCode: "void AdvectPlume(inout VFXAttributes a)\n{\n    float heat = exp(-2.8 * a.age);\n    float phase = a.particleId / 300.0 + a.age;\n    float3 p = a.position * 13.0;\n    // Curl of a time-varying vector potential gives divergence-free eddies\n    float3 curl = float3(cos(p.y - phase * 6.0) - sin(p.z + phase),\n                         cos(p.z + phase * 3.0) - sin(p.x - phase),\n                         cos(p.x + phase * 4.0) - sin(p.y + phase));\n    // Integrate buoyant acceleration as hot gas cools exponentially\n    a.velocity = float3(0, 0.35 + 1.5 * (1.0 - heat), 0) + 0.20 * curl;\n    float life = saturate(a.age / a.lifetime);\n    a.size = lerp(0.14, 0.025, life);\n    a.scaleY = 1.65;\n    a.color = lerp(float3(1.9, 0.12, 0.008), float3(3.8, 1.6, 0.36), heat * heat);\n    a.alpha = 0.27 * (1.0 - life * life);\n}"
  m_ShaderFile: {fileID: 0}

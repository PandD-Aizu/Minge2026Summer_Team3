  m_ActivationSlot: {fileID: 8926484042661615901}
  m_BlockName: Emit hot gas from wick
  m_HLSLCode: "void EmitWick(inout VFXAttributes a)\n{\n    float angle = 6.2831853 * frac(a.particleId * 0.618034);\n    float radius = 0.055 * sqrt(frac(a.particleId * 0.754878));\n    a.position = float3(radius * cos(angle), 0, radius * sin(angle));\n    a.lifetime = 0.32 + 0.24 * frac(a.particleId * 0.414214);\n}"
  m_ShaderFile: {fileID: 0}

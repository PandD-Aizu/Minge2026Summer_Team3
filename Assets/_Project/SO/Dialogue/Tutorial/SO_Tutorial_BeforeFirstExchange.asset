  _lines:
  - _speaker: 1
    _text: "\u304A\u304B\u3048\u308A\u3001\u9B5A\u304C\u91E3\u308C\u305F\u3093\u3060\u30CD\u3002"
  - _speaker: 1
    _text: "\u96A3\u306E\u7121\u4EBA\u96C6\u8377\u6240\u3067\u3001\u305D\u306E\u9B5A\u3092\u4EA4\u63DB\u3057\u3066\u30CD\u3002"
  - _speaker: 1
    _text: "\u3068\u8A00\u3044\u305F\u3044\u3068\u3053\u308D\u3060\u3051\u3069\u3001"
  - _speaker: 1
    _text: "\u307E\u3060\u4EA4\u63DB\u3067\u304D\u306A\u3044\u304B\u3089\u3001\u91E3\u308A\u5834\u3067\u591C\u306E\u91E3\u308A\u3092\u697D\u3057\u3093\u3067\u30CD"

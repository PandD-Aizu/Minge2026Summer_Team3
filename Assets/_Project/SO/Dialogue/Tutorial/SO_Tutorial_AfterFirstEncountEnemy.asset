  _lines:
  - _speaker: 1
    _text: "\u306A\u306B\u304B\u3042\u3063\u305F\u9854\u3092\u3057\u3066\u308B\u30CD"
  - _speaker: 1
    _text: "\u30BD\u30EC\u304C\u3053\u306E\u30D0\u30A4\u30C8\u306E\u7D66\u6599\u304C\u3044\u3044\u7406\u7531\u306A\u3093\u3060\u30E8\u3002"
  - _speaker: 1
    _text: "\u591C\u91E3\u308A\u306F\u3059\u3054\u304F\u5371\u967A\u306A\u3093\u3060\u3002"
  - _speaker: 1
    _text: "\u3067\u3082\u5F15\u304D\u53D7\u3051\u305F\u304B\u3089\u306B\u306F\u4ED5\u4E8B\u306F\u3057\u3066\u3082\u3089\u3046\u304B\u3089\u30CD\u3002"
  - _speaker: 1
    _text: "\u3055\u3042\u3001\u30CE\u30EB\u30DE\u306E\u305F\u3081\u306B\u91E3\u308A\u5834\u306B\u623B\u3063\u3066\u30CD"
  _playOncePerSave: 0
  _saveId: 7b1874fa2a005864e9f8b42064f2be64

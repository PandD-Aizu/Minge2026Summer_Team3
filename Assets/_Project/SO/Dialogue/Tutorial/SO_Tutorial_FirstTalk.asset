  m_Script: {fileID: 11500000, guid: 69f1088660344b09a282e35d86447062, type: 3}
  m_Name: SO_Tutorial_FirstTalk
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue.DialogueData
  _lines:
  - _speaker: 1
    _text: "\u30D0\u30A4\u30C8\u306B\u5FDC\u52DF\u3057\u3066\u304F\u308C\u305F\u4EBA\u3060\u30CD\u3001\u3069\u3046\u3082\u3042\u308A\u304C\u3068\u3046\u3002"
  - _speaker: 0
    _text: "\u3068\u3093\u3067\u3082\u306A\u3044\u3067\u3059\u3001\u3053\u3093\u306A\u6761\u4EF6\u306E\u3044\u3044\u4ED5\u4E8B\u4E2D\u3005\u898B\u3064\u304B\u3089\u306A\u3044\u306E\u3067..."
  - _speaker: 1
    _text: "\u4E0D\u671F\u5B9A\u3067\u52DF\u96C6\u3057\u3066\u308B\u3093\u3060\u30E8\u3001"
  - _speaker: 1
    _text: "\u3044\u3044\u30D0\u30A4\u30C8\u3060\u3068\u601D\u3063\u3066\u304F\u308C\u305F\u306A\u3089\u30E9\u30C3\u30AD\u30FC\u3060\u3063\u305F\u30CD\u3002"
  - _speaker: 0
    _text: "...\uFF1F \u9811\u5F35\u308A\u307E\u3059\uFF01"
  - _speaker: 1
    _text: "\u305D\u3057\u305F\u3089\u3055\u3063\u305D\u304F\u91E3\u308A\u5834\u3067\u9B5A\u3092\u91E3\u3063\u3066\u304D\u3066\u3082\u3089\u304A\u3046\u304B\u306A\u3002"
  - _speaker: 1
    _text: "\u3053\u3053\u304B\u3089\u3055\u3089\u306B\u53F3\u306B\u9032\u3080\u3068\u91E3\u308A\u5834\u304C\u3042\u308B\u304B\u3089\u30CD\u3002"
  - _speaker: 1
    _text: "\u91E3\u308C\u305F\u3089\u3053\u3063\u3061\u306B\u623B\u3063\u3066\u304D\u3066\u30CD\u3002"
  _playOncePerSave: 0
  _saveId: f5bd28c2e18146642958d9c374fb506f
